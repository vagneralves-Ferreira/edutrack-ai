              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Prefer",
                "value": "return=representation"
              }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/study_sessions",
              "host": [
                "{{supabase_url}}"
              ],
              "path": [
                "rest",
                "v1",
                "study_sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"subjectId\": \"uuid-da-disciplina\",\n    \"durationMinutes\": 45,\n    \"date\": \"2026-10-06T12:00:00Z\",\n    \"topic\": \"Revisão de SELECT e JOIN\"\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "supabase_url",
      "value": "https://sua-url-aqui.supabase.co",
      "type": "string"
    },
    {
      "key": "supabase_key",
      "value": "sua-anon-key-aqui",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "seu-jwt-token-aqui",
      "type": "string"
    }
  ]
}