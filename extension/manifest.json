{
  "manifest_version": 3,
  "name": "EduTrack AI — Sincronizador Acadêmico",
  "version": "1.0.0",
  "description": "Importe disciplinas, atividades e prazos do portal da sua faculdade para o EduTrack AI com um clique.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://pcrmuevfjujrrecgprwm.supabase.co/*"
  ],
  "action": {
    "default_title": "EduTrack AI — Sincronizador Acadêmico",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
